@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
title Вариант 1 — обработка событий с дорожками
|Модель и календарь|
start
:Проверить N≥1, M≥1, B≥1, λi>0,\n0<tmin≤tmax; установить p=0;
:Запланировать первое поступление\nкаждого источника по ИЗ1;
while (Есть событие в пределах наблюдения?) is (да)
 :Извлечь ближайшее событие;\nзавершение раньше поступления\nпри одинаковом времени;
 |Статистика и источники|
 :Учесть занятость и очередь\nза прошедший интервал;
 |Модель и календарь|
 if (Тип события?) then (поступление)
  |Статистика и источники|
  :Создать q и учесть поступление;\nзапланировать следующее\nΔt = −ln(U)/λi по ИЗ1;
  |Диспетчер постановки|
  :accept(q, t);
  |Диспетчер выбора и приборы|
  :Найти свободный прибор\nот IMG-1 до IMG-M по Д2П1;
  if (Прибор найден?) then (да)
   :startOn(q, d, t);\nбуфер пуст по инварианту;
   :Занять d; τ ∼ U[tmin;tmax] (ПЗ2);\nзапланировать завершение t+τ;
   |Статистика и источники|
   :Учесть начало обслуживания q;
  else (нет)
   |Диспетчер постановки|
   :Вызвать buffer.offer(q);
   |Буфер|
   :Начать с текущего p;\nпроверить не более B ячеек по кольцу;
   if (Свободная ячейка k найдена?) then (да)
    :Д10З1 — записать q в slots[k];
   else (нет)
    :Полный обход вернул p в исходную позицию;\nД10О1 — old=slots[p]; k=p;\nзаменить old новой q;
    |Статистика и источники|
    :Учесть отказ old;\nуведомить old.sourceId — 503 OVERLOAD;
    |Буфер|
   endif
   :Установить p=(k+1) mod B;
   |Статистика и источники|
   :Учесть постановку q в буфер\nи новое положение p;
  endif
 else (завершение)
  |Диспетчер выбора и приборы|
  :Завершить q на приборе;\nполучить resultUri; освободить прибор;
  |Статистика и источники|
  :Учесть завершение и время q в системе;\nуведомить q.sourceId о результате;
  |Диспетчер выбора и приборы|
  :Вызвать dispatchWaiting(t);
  while (Буфер непуст и есть свободный прибор?) is (да)
   :Выбрать свободный прибор\nс минимальным номером по Д2П1;
   |Буфер|
   :Д2Б1 — выбрать min(arrivalAt, requestId);\nудалить заявку из её ячейки;\np оставить без изменения;
   |Статистика и источники|
   :Учесть выборку и ожидание заявки;
   |Диспетчер выбора и приборы|
   :startOn(q, d, t); занять прибор;\nτ ∼ U[tmin;tmax] (ПЗ2);\nзапланировать завершение t+τ;
   |Статистика и источники|
   :Учесть начало обслуживания;
   |Диспетчер выбора и приборы|
  endwhile (нет)
 endif
 |Статистика и источники|
 :Зафиксировать ОД1 — календарь,\nячейки, p, состояния приборов, показатели;
 |Модель и календарь|
endwhile (нет)
|Статистика и источники|
:Учесть последний интервал до T;\nполучить показатели;\nдля серии экспериментов — графики ОР2;
stop
@enduml
